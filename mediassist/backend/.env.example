# MediAssist AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Environment Mode
# Set to 'production' when deployed, 'development' for local testing
ENVIRONMENT=development

# OpenAI API Key (optional - app works without it in context-based mode)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Server settings
# HOST: 0.0.0.0 for all interfaces (required for Render), 127.0.0.1 for localhost
HOST=0.0.0.0

# PORT: Usually 8000 for local, Render auto-assigns PORT env var
PORT=8000

# CORS settings (frontend URL for production)
# When deployed, update this with your Vercel frontend URL
FRONTEND_URL=http://localhost:5173

